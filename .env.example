# Add this value in Vercel for Development, Preview, and Production.
OPENROUTER_API_KEY=

# Keep false until a real sign-in, rate-limit, and quota boundary is implemented.
# True is permitted only for a restricted internal demo with a tightly capped key.
OPENROUTER_ALLOW_UNAUTHENTICATED_DEMO=false

# Optional: override these tiers with model slugs available to your OpenRouter account.
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
OPENROUTER_MODEL_BALANCED=anthropic/claude-sonnet-4
OPENROUTER_MODEL_DEEP=anthropic/claude-opus-4.1

# Optional: model routing for Compare.
OPENROUTER_MODEL_CLAUDE=anthropic/claude-sonnet-4
OPENROUTER_MODEL_GPT=~openai/gpt-latest
OPENROUTER_MODEL_GEMINI=google/gemini-2.5-pro

# Optional: deployed public URL for OpenRouter attribution.
OPENROUTER_SITE_URL=
