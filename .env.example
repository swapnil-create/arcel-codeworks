# Add this value in Vercel for Development, Preview, and Production.
OPENROUTER_API_KEY=

# Keep false. This flag is not authorization and must not enable unauthenticated spend.
# True is never a substitute for a signed session.
OPENROUTER_ALLOW_UNAUTHENTICATED_DEMO=false

# Session cookie HMAC. Generate locally with: openssl rand -base64 48
# Leave empty in this file. Set the real value only in Vercel / .env.local (gitignored).
AUTH_SECRET=

# Public origin used for OAuth redirect URIs. Example: https://arcel-codeworks.vercel.app
AUTH_URL=

# GitHub OAuth App (callback: {AUTH_URL}/api/auth/callback). Client ID is public; secret stays in Vercel.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional Google OAuth client (same callback URL).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: override these tiers with model slugs available to your OpenRouter account.
OPENROUTER_MODEL_FAST=google/gemini-2.5-flash
OPENROUTER_MODEL_BALANCED=anthropic/claude-sonnet-4
OPENROUTER_MODEL_DEEP=anthropic/claude-opus-4.1

# Optional: model routing for Compare.
OPENROUTER_MODEL_CLAUDE=anthropic/claude-sonnet-4
OPENROUTER_MODEL_GPT=~openai/gpt-latest
OPENROUTER_MODEL_GEMINI=google/gemini-2.5-pro

# Optional: deployed public URL for OpenRouter attribution.
OPENROUTER_SITE_URL=
