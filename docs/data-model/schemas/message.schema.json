{
  "$id": "https://arcel.local/schema/message",
  "title": "Message",
  "description": "Assistant response versions are immutable. Generation failures are Run errors, not assistant messages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "conversation_id", "role", "parts", "version", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^msg_" },
    "conversation_id": { "type": "string", "pattern": "^conv_" },
    "parent_message_id": { "type": ["string", "null"] },
    "role": { "type": "string", "enum": ["user", "assistant", "system"] },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["text", "refusal"] },
          "text": { "type": "string" }
        }
      }
    },
    "run_id": { "type": ["string", "null"] },
    "version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
